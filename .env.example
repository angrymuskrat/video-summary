# Copy this file to `.env` before starting the compose stack.

# Backend application settings.
VIDEO_SUMMARY_ARTIFACT_RETENTION_HOURS=168
VIDEO_SUMMARY_CLEANUP_INTERVAL_SECONDS=1800
VIDEO_SUMMARY_SUMMARIZER_PROVIDER=openai
OPENAI_BASE_URL=http://vllm:8000/v1
OPENAI_API_KEY=local-vllm
OPENAI_TIMEOUT_SEC=120

# vLLM model presets for transcript summarization.
VLLM_MODEL_16GB=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_MODEL_24GB=Qwen/Qwen2.5-14B-Instruct-AWQ

# Pick one preset value explicitly for the active model.
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ

# Local cache directory for downloaded model weights.
VLLM_CACHE_DIR=./docker/models/huggingface
VLLM_HOST_PORT=8000
VLLM_API_KEY=local-vllm
VLLM_QUANTIZATION=awq
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.92

# Optional external tokens.
HF_TOKEN=
